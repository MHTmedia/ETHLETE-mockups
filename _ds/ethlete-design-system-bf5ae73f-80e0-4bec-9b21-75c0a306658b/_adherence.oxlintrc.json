{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/icons/**",
              "components/commerce/**",
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/media/**",
              "components/navigation/**",
              "ui_kits/storefront/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Poppins|Saira))/i]",
        "message": "Font not provided by the design system. Available: Poppins, Saira."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|defaultOpen|children|key|ref|className|style|children)$/]",
        "message": "<AccordionItem> doesn't accept that prop. Declared props: title, defaultOpen, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnouncementBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:messages|speed|background|key|ref|className|style|children)$/]",
        "message": "<AnnouncementBar> doesn't accept that prop. Declared props: messages, speed, background."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|square|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, square, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:lime|sale|ink|cream)$/]",
        "message": "<Badge> tone must be one of 'lime' | 'sale' | 'ink' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Crumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<Crumb> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrickSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|imageSide|eyebrow|heading|body|bullets|footnote|cta|ctaHref|ctaVariant|background|minHeight|key|ref|className|style|children)$/]",
        "message": "<BrickSection> doesn't accept that prop. Declared props: image, imageSide, eyebrow, heading, body, bullets, footnote, cta, ctaHref, ctaVariant, background, minHeight."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrickSection'] > JSXAttribute[name.name='imageSide'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<BrickSection> imageSide must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrickSection'] > JSXAttribute[name.name='ctaVariant'] > Literal[value!=/^(?:solid|accent|outline|inverse)$/]",
        "message": "<BrickSection> ctaVariant must be one of 'solid' | 'accent' | 'outline' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|as|fullWidth|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, as, fullWidth, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|accent|outline|inverse)$/]",
        "message": "<Button> variant must be one of 'solid' | 'accent' | 'outline' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|body|key|ref|className|style|children)$/]",
        "message": "<IconColumn> doesn't accept that prop. Declared props: icon, title, body."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeaderNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|active|key|ref|className|style|children)$/]",
        "message": "<HeaderNavItem> doesn't accept that prop. Declared props: label, href, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='NewsletterForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|intro|introLink|cta|legal|onSubmit|key|ref|className|style|children)$/]",
        "message": "<NewsletterForm> doesn't accept that prop. Declared props: heading, intro, introLink, cta, legal, onSubmit."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|price|compareAt|from|image|hoverImage|salePrice|saleCompareAt|flag|bordered|quickAdd|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: title, price, compareAt, from, image, hoverImage, salePrice, saleCompareAt, flag, bordered, quickAdd."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductGallery'] > JSXAttribute > JSXIdentifier[name!=/^(?:images|salePrice|saleCompareAt|key|ref|className|style|children)$/]",
        "message": "<ProductGallery> doesn't accept that prop. Declared props: images, salePrice, saleCompareAt."
      },
      {
        "selector": "JSXOpeningElement[name.name='PurchaseOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|onSelect|name|price|compareAt|savings|cadence|bullets|key|ref|className|style|children)$/]",
        "message": "<PurchaseOption> doesn't accept that prop. Declared props: selected, onSelect, name, price, compareAt, savings, cadence, bullets."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: checked, onChange, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:align|children|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: align, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|start)$/]",
        "message": "<SectionLabel> align must be one of 'center' | 'start'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StarRating'] > JSXAttribute > JSXIdentifier[name!=/^(?:rating|count|score|verified|size|key|ref|className|style|children)$/]",
        "message": "<StarRating> doesn't accept that prop. Declared props: rating, count, score, verified, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickyAddToCart'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|price|cta|onAdd|key|ref|className|style|children)$/]",
        "message": "<StickyAddToCart> doesn't accept that prop. Declared props: image, title, price, cta, onAdd."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tone|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<TextField> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Video'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|poster|mode|ratio|caption|attribution|objectFit|radius|background|key|ref|className|style|children)$/]",
        "message": "<Video> doesn't accept that prop. Declared props: src, poster, mode, ratio, caption, attribution, objectFit, radius, background."
      },
      {
        "selector": "JSXOpeningElement[name.name='Video'] > JSXAttribute[name.name='objectFit'] > Literal[value!=/^(?:cover|contain)$/]",
        "message": "<Video> objectFit must be one of 'cover' | 'contain'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
